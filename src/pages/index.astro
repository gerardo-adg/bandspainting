---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Quiz from '../components/Quiz.astro';
import Proof from '../components/Proof.astro';
import { site } from '../site.config';
import logo from '../assets/logo.png';
import heroImg from '../assets/photos/hero-light.jpg';

const heroLg = await getImage({ src: heroImg, width: 1920, format: 'webp', quality: 74 });
const heroSm = await getImage({ src: heroImg, width: 900, format: 'webp', quality: 70 });
const tel = site.phone.replace(/[^\d+]/g, '');

const steps = [
  { t: 'Answer 3 quick questions', d: 'Tell us what you need. It takes less than a minute.' },
  { t: 'We call to schedule', d: 'A friendly member of our team reaches out to set up a visit.' },
  { t: 'Get your free estimate', d: 'Clear, detailed pricing for your project. No pressure, no obligation.' },
];
---
<Base title={`Free Painting Estimate | ${site.businessName}`} description={`Free estimates on painting, staining, dry rot, siding, decking & drywall repair from ${site.businessName}. ${site.serviceArea}. Takes less than 60 seconds.`}>
  <header class="topbar">
    <div class="topbar-in">
      <Image src={logo} alt={site.businessName} height={72} densities={[1, 2]} class="logo" loading="eager" />
    </div>
  </header>

  <section class="hero" style={`--hero-lg:url(${heroLg.src});--hero-sm:url(${heroSm.src})`}>
    <div class="hero-in">
      <div class="pitch">
        <p class="pill"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>{site.serviceArea}</p>
        <h1>Get Your Free<br /><em>Painting Estimate</em></h1>
        <p class="lead">Painting, staining &amp; repairs · 3 quick questions</p>
        <div class="proof-desk"><Proof variant="desktop" /></div>
      </div>

      <div class="card" id="start">
        <Quiz />
      </div>

      <div class="proof-mob"><Proof variant="mobile" /></div>
    </div>
  </section>

  <section class="how">
    <div class="how-in">
      <p class="eyebrow">How it works</p>
      <h2>A beautiful finish, without the hassle.</h2>
      <ol>
        {steps.map((s, i) => (
          <li>
            <span class="num">0{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
      <a class="again" href="#start">Start my free estimate</a>
    </div>
  </section>

  <footer class="foot">
    <p>© {new Date().getFullYear()} {site.businessName} · {site.serviceArea}</p>
    {tel && <p><a href={`tel:${tel}`}>{site.phone}</a></p>}
  </footer>
</Base>

<style>
  .topbar{background:#fff;position:relative;z-index:2;border-bottom:1px solid var(--line)}
  .topbar-in{max-width:1180px;margin:0 auto;padding:10px 16px;display:flex;align-items:center;justify-content:center}
  .logo{height:54px;width:auto}
  @media (min-width:900px){
    .topbar-in{padding:12px 24px}
    .logo{height:64px}
  }

  .hero{position:relative;color:var(--ink);background-color:#f4f7fb;
    background-image:linear-gradient(180deg,rgba(255,255,255,.9) 0%,rgba(244,247,251,.94) 40%,#f4f7fb 75%),var(--hero-sm);
    background-size:100% 100%,cover;background-position:center,center 35%;background-repeat:no-repeat}
  @media (min-width:900px){
    .hero{background-color:#fff;
      background-image:linear-gradient(90deg,#fff 0%,#fff 42%,rgba(255,255,255,.8) 56%,rgba(255,255,255,.12) 80%,rgba(255,255,255,0) 100%),var(--hero-lg);
      background-size:100% 100%,cover;background-position:center,right 40%}
  }
  .hero-in{max-width:1180px;margin:0 auto;padding:26px 16px 44px;display:grid;gap:22px}
  @media (min-width:900px){
    .hero-in{grid-template-columns:1fr 540px;align-items:center;gap:56px;padding:72px 24px 88px;min-height:calc(100vh - 88px)}
  }

  .pitch{text-align:center}
  @media (min-width:900px){.pitch{text-align:left}}
  .pill{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:999px;font-size:13px;font-weight:700;letter-spacing:.01em;
    background:var(--brand);color:#fff}
  .pill svg{width:15px;height:15px;flex:none;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
  h1{font-family:var(--display);font-weight:400;font-size:clamp(34px,8.6vw,62px);line-height:1.08;letter-spacing:-.005em;margin:16px 0 0;color:var(--black)}
  h1 em{font-style:normal;color:var(--brand);
    text-decoration:underline;text-decoration-color:var(--brand);text-decoration-thickness:.07em;
    text-underline-offset:.14em;text-decoration-skip-ink:auto}
  .lead{margin-top:14px;font-size:clamp(16px,4vw,19px);color:#3d4757;font-weight:500}
  .proof-desk{display:none;margin-top:20px}
  .proof-mob{display:block}
  .proof-mob :global(.proof){margin:0 auto}
  @media (min-width:900px){.proof-desk{display:block}.proof-mob{display:none}}

  .card{background:#fff;color:var(--ink);border-radius:24px;padding:22px 18px 22px;scroll-margin-top:12px;
    box-shadow:0 0 0 1px rgba(13,22,38,.07),0 2px 4px rgba(13,22,38,.04),0 40px 80px -36px rgba(13,22,38,.45)}
  @media (min-width:480px){.card{padding:30px 28px 26px}}

  .how{background:#fff;border-top:1px solid var(--line);padding:64px 16px 72px}
  .how-in{max-width:1080px;margin:0 auto;text-align:center}
  .eyebrow{font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--brand)}
  .how h2{font-family:var(--serif);font-weight:800;color:var(--black);font-size:clamp(27px,6vw,40px);line-height:1.12;letter-spacing:-.01em;margin-top:10px}
  .how ol{list-style:none;display:grid;gap:16px;margin-top:36px;text-align:left}
  @media (min-width:760px){.how ol{grid-template-columns:repeat(3,1fr);gap:20px}}
  .how li{background:#f4f7fb;border:1px solid var(--line);border-radius:20px;padding:26px 24px}
  .num{font-family:var(--display);font-size:30px;color:var(--brand)}
  .how h3{font-size:18px;font-weight:800;margin-top:10px}
  .how li p{color:var(--muted);margin-top:6px;line-height:1.55;font-size:15px}
  .again{display:inline-block;margin-top:34px;padding:17px 30px;border-radius:14px;background:var(--brand);color:#fff;text-decoration:none;font-weight:800;
    transition:background .15s}
  .again:hover{background:var(--brand-600)}

  .foot{background:var(--black);color:rgba(255,255,255,.55);text-align:center;font-size:13px;padding:28px 16px calc(28px + env(safe-area-inset-bottom));display:grid;gap:6px}
  .foot a{color:rgba(255,255,255,.8);text-decoration:none}
</style>
