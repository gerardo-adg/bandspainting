---
import { site } from '../site.config';
import { rating, reviews } from '../data/reviews';

const G = `<svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg>`;
const stars = '★★★★★';
const tints = ['#0063ac', '#0b0f17', '#2f7d4f', '#8a4fbf', '#c2410c', '#0e7490'];
---
<section class="reviews" aria-labelledby="reviews-title">
  <div class="rv-in">
    <div class="rv-head">
      <div>
        <h2 id="reviews-title">What Sacramento homeowners say</h2>
        <a class="rv-score" href={site.googleReviewsUrl} target="_blank" rel="noopener">
          <span class="g" set:html={G} />
          <strong>{rating.score}</strong>
          <span class="stars" aria-label={`${rating.score} out of 5 stars`}>{stars}</span>
          <span class="count">Google reviews</span>
        </a>
      </div>
      <div class="rv-nav">
        <button type="button" class="rv-btn" data-dir="-1" aria-label="Previous reviews"><svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg></button>
        <button type="button" class="rv-btn" data-dir="1" aria-label="Next reviews"><svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg></button>
      </div>
    </div>

    <ul class="rv-track" tabindex="0" aria-label="Google reviews">
      {reviews.map((r, i) => (
        <li class="rv-card">
          <div class="rv-top">
            <span class="stars" aria-label="5 out of 5 stars">{stars}</span>
            <span class="g g-sm" set:html={G} />
          </div>
          <p class="rv-text">{r.text}</p>
          <button type="button" class="rv-more" hidden>Read more</button>
          <div class="rv-who">
            <span class="av" style={`background:${tints[i % tints.length]}`}>{r.name[0]}</span>
            <span><strong>{r.name}</strong><small>{r.service}</small></span>
          </div>
        </li>
      ))}
    </ul>

    <div class="rv-dots" aria-hidden="true">
      {reviews.map(() => <i />)}
    </div>

    <a class="rv-all" href={site.googleReviewsUrl} target="_blank" rel="noopener">See all reviews on Google →</a>
  </div>
</section>

<style>
  .reviews{background:#fff;border-top:1px solid var(--line);padding:56px 0 52px}
  .rv-in{max-width:1180px;margin:0 auto}
  .rv-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;padding:0 16px}
  @media (min-width:900px){.rv-head{padding:0 24px}}
  h2{font-family:var(--serif);font-weight:800;font-size:clamp(26px,5.6vw,38px);line-height:1.12;letter-spacing:-.01em;color:var(--black)}
  .rv-score{display:inline-flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:12px;text-decoration:none;color:var(--ink)}
  .rv-score strong{font-size:18px;font-weight:800}
  .rv-score .count{font-size:14.5px;font-weight:600;color:var(--muted);text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--line)}
  .g{display:inline-flex;width:22px;height:22px}
  .g :global(svg){width:100%;height:100%}
  .g-sm{width:18px;height:18px}
  .stars{color:#f5b301;letter-spacing:1px;font-size:17px;line-height:1}

  .rv-nav{display:none;gap:8px;flex:none}
  @media (min-width:900px){.rv-nav{display:flex}}
  .rv-btn{width:44px;height:44px;border-radius:50%;border:1.5px solid var(--line);background:#fff;cursor:pointer;display:grid;place-items:center;transition:border-color .15s,background .15s}
  .rv-btn:hover:not(:disabled){border-color:var(--brand)}
  .rv-btn:disabled{opacity:.35;cursor:default}
  .rv-btn svg{width:20px;height:20px;fill:none;stroke:var(--ink);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}

  .rv-track{list-style:none;margin:26px 0 0;padding:4px 16px 8px;display:grid;grid-auto-flow:column;grid-auto-columns:86%;gap:12px;
    overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 16px;scrollbar-width:none;-webkit-overflow-scrolling:touch;outline:none}
  .rv-track::-webkit-scrollbar{display:none}
  @media (min-width:600px){.rv-track{grid-auto-columns:calc((100% - 32px - 12px)/2)}}
  @media (min-width:900px){.rv-track{padding:4px 24px 8px;scroll-padding:0 24px;gap:18px;grid-auto-columns:calc((100% - 48px - 36px)/3)}}

  .rv-card{scroll-snap-align:start;display:flex;flex-direction:column;padding:22px 22px 20px;border-radius:16px;background:#f4f7fb;border:1px solid var(--line)}
  .rv-top{display:flex;align-items:center;justify-content:space-between}
  .rv-text{margin-top:14px;font-size:15.5px;line-height:1.6;color:var(--ink);display:-webkit-box;-webkit-line-clamp:6;-webkit-box-orient:vertical;overflow:hidden}
  .rv-card.open .rv-text{-webkit-line-clamp:unset;display:block}
  .rv-more{align-self:flex-start;margin-top:6px;background:none;border:0;padding:0;cursor:pointer;font-size:14px;font-weight:700;color:var(--brand)}
  .rv-who{display:flex;align-items:center;gap:12px;margin-top:auto;padding-top:18px}
  .av{flex:none;width:38px;height:38px;border-radius:50%;color:#fff;display:grid;place-items:center;font-weight:800;font-size:16px}
  .rv-who strong{display:block;font-size:15px}
  .rv-who small{display:block;font-size:13px;color:var(--muted)}

  .rv-dots{display:flex;justify-content:center;gap:6px;margin-top:14px}
  .rv-dots i{width:7px;height:7px;border-radius:50%;background:#cfd6e0;transition:background .2s,width .2s}
  .rv-dots i.on{background:var(--brand);width:18px;border-radius:99px}
  @media (min-width:900px){.rv-dots{display:none}}

  .rv-all{display:table;margin:22px auto 0;font-size:15px;font-weight:700;color:var(--brand);text-decoration:none}
  .rv-all:hover{text-decoration:underline}
</style>

<script>
  const track = document.querySelector<HTMLElement>('.rv-track')!;
  const cards = Array.from(track.querySelectorAll<HTMLElement>('.rv-card'));
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.rv-dots i'));
  const [prev, next] = Array.from(document.querySelectorAll<HTMLButtonElement>('.rv-btn'));

  // "Read more" only on reviews that are actually cut off
  const setupMore = () => cards.forEach((c) => {
    const t = c.querySelector<HTMLElement>('.rv-text')!;
    const b = c.querySelector<HTMLButtonElement>('.rv-more')!;
    if (!c.classList.contains('open')) b.hidden = t.scrollHeight <= t.clientHeight + 2;
  });
  cards.forEach((c) => c.querySelector('.rv-more')!.addEventListener('click', (e) => {
    const open = c.classList.toggle('open');
    (e.currentTarget as HTMLButtonElement).textContent = open ? 'Show less' : 'Read more';
  }));

  const step = () => cards[0].getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || '12');
  const update = () => {
    const max = track.scrollWidth - track.clientWidth - 2;
    prev.disabled = track.scrollLeft <= 2;
    next.disabled = track.scrollLeft >= max;
    const i = Math.round(track.scrollLeft / step());
    dots.forEach((d, k) => d.classList.toggle('on', k === Math.min(i, dots.length - 1)));
  };
  [prev, next].forEach((b) => b.addEventListener('click', () => track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: 'smooth' })));
  track.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', () => { setupMore(); update(); });
  document.fonts?.ready.then(() => { setupMore(); update(); });
  setupMore(); update();
</script>
