---
import { Image } from 'astro:assets';
import { site } from '../site.config';
import award from '../assets/award.png';

interface Props { variant?: 'desktop' | 'mobile' }
const { variant = 'mobile' } = Astro.props;
// Desktop: award first, then only the first two trust points.
const points = variant === 'desktop' ? site.trust.slice(0, 2) : site.trust;
---
<div class:list={['proof', variant]}>
  <ul class="trust">
    {points.map((t) => (
      <li><svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10"/></svg>{t}</li>
    ))}
  </ul>

  <div class="award">
    <Image src={award} alt="Best of BusinessRate 2025 award plaque: B&S Painting Inc, Painter, Sacramento, California" width={92} densities={[1, 2]} class="plaque" loading="lazy" />
    <div class="award-txt">
      <p class="award-kicker">Award winner</p>
      <p class="award-title">Best of 2025 · Painter</p>
      <p class="award-sub">BusinessRate · Sacramento, California</p>
      <p class="award-note">Based on recent Google reviews</p>
    </div>
  </div>
</div>

<style>
  .proof{display:grid;gap:10px;max-width:520px}
  .proof.desktop .award{order:-1}   /* award above the trust points on desktop */
  .trust{list-style:none;display:grid;grid-template-columns:1fr;gap:8px;margin:0;padding:0}
  @media (min-width:480px){.trust{grid-template-columns:1fr 1fr;gap:10px}}
  .trust li{display:flex;align-items:center;gap:10px;padding:13px 14px;border-radius:12px;background:#fff;border:1px solid var(--line);
    box-shadow:0 6px 14px -12px rgba(13,22,38,.4);font-weight:700;font-size:14.5px;line-height:1.25;color:var(--ink);text-align:left}
  .trust svg{flex:none;width:20px;height:20px;padding:3.5px;border-radius:50%;background:var(--brand);fill:none;stroke:#fff;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}

  .award{display:flex;align-items:center;gap:18px;padding:14px 18px 14px 14px;border-radius:14px;background:#fff;border:1px solid var(--line);
    box-shadow:0 6px 14px -12px rgba(13,22,38,.4);text-align:left}
  .plaque{flex:none;width:76px;height:auto;border-radius:4px;box-shadow:0 8px 16px -8px rgba(0,0,0,.45)}
  @media (min-width:480px){.plaque{width:92px}}
  .award-txt p{margin:0}
  .award-kicker{font-size:11.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--brand)}
  .award-title{font-family:var(--serif);font-weight:800;font-size:clamp(19px,4.6vw,22px);line-height:1.15;color:var(--black);margin-top:4px !important}
  .award-sub{font-size:14px;font-weight:700;color:var(--ink);margin-top:6px !important}
  .award-note{font-size:12.5px;color:var(--muted);margin-top:2px !important}
</style>
